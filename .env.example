DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
TEMPERATURE=0
MAX_TURNS=10
EMBEDDING_MODEL=Xenova/multilingual-e5-small
NOTES_DIR=./notes
# 国内连不上 huggingface.co 时，取消下一行注释走镜像下载 embedding 模型：
# HF_ENDPOINT=https://hf-mirror.com
# 或者把模型手动下到本地目录后离线加载（完全不走网络）：
# LOCAL_MODEL_PATH=./models
# 记忆 + 上下文压缩
SESSION_ID=default
# SESSIONS_DIR=./.sessions
# 历史超过这个估算 token 数就触发 LLM 摘要压缩（想看压缩效果可调小，如 50）
MAX_CONTEXT_TOKENS=2000
# 压缩时保留的最近消息条数
KEEP_RECENT=6
# 生产化（Stage 4a）
# 主模型失败时切到的备用模型（默认与主模型相同 = 仅作多一层重试保险）
# FALLBACK_MODEL=deepseek-reasoner
MAX_RETRIES=2
# LLM 结果缓存：设 0 关闭
LLM_CACHE=1
# LLM_CACHE_DIR=./.llm-cache
# 流式输出最终答案：设 0 关闭
STREAM=1
# --- 自定义端点（只有 rs/ 那版读这三个）---
# 第三方聚合站、公司内网网关、本地跑的 Ollama / LM Studio / vLLM 都走这里。
# 注意：rs 版**不再读** DEEPSEEK_BASE_URL 之类的按厂商覆盖键（内置厂商的
# 地址是固定的），要指别的地址就用下面这三个。TS 版仍然读上面那个。
# CUSTOM_BASE_URL=http://localhost:11434/v1
# CUSTOM_API_KEY=            # 本地服务通常不校验，可以不填
# CUSTOM_MODELS=llama3.1,qwen2.5:14b

# --- 内置 agent 的手脚（只有 rs/ 那版）---
# 工作目录不在这里配 —— 它就是会话所属**项目的目录**（新建对话时选的那个），
# 内置 agent 和外部 CLI 共用同一个。没有项目的会话不会有文件和命令工具。
#
# 联网搜索：优先用**厂商自带的**（智谱、通义千问已接，用同一把模型 key，
# 不用另外注册）。厂商没有的话才回落到下面这两个可选的搜索服务。
# 自定义端点（OpenRouter 等）在设置里填「联网搜索工具」那一栏。
# BRAVE_API_KEY=
# TAVILY_API_KEY=
